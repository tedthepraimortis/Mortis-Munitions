// ------------------------------------------------------------
// D4RT
// ------------------------------------------------------------
class MM_MCellCasing:HDDebris{
	default{
		scale 0.3;height 4;radius 4;bouncefactor 0.6;
		bouncesound "nil";
	}
	states{
	spawn:
		MCLL D 0 nodelay A_ChangeVelocity(cos(pitch),0,sin(-pitch)+1,CVF_RELATIVE);
	spawn2:
		MCLL D random(1,3){angle+=45;}
		loop;
	death:
		---- A -1{
			A_FaceMovementDirection();
			angle+=90;
		}
		stop;
	}
}

class MM_Dart:HDWeapon{
	default{
		+hdweapon.fitsinbackpack
		weapon.selectionorder 60;
		weapon.slotnumber 6;
		weapon.slotpriority 2;
		weapon.kickback 100;
		weapon.bobrangex 0.21;
		weapon.bobrangey 0.86;
		scale 0.6;
		inventory.pickupmessage "$PICKUP_D4RT";
		obituary "$OB_D4RT";
		hdweapon.barrelsize 34,1,2;
		tag "$TAG_D4RT";
		hdweapon.refid "d4t";

		hdweapon.ammo1 "HDMicroCell",1;
	}
    // Can be an int, should be reset when deselected. - [Tavi]
    int charge;
	override bool AddSpareWeapon(actor newowner){return AddSpareWeaponRegular(newowner);}
	override hdweapon GetSpareWeapon(actor newowner,bool reverse,bool doselect){return GetSpareWeaponRegular(newowner,reverse,doselect);}
	override void tick(){
		super.tick();
		drainheat(D4RTS_HEAT,12);
		buntossable=hd_instagib;
	}
	override double gunmass(){
		double amt=weaponstatus[D4RTS_CHAMBER];
		return 6+amt*amt;
	}
	override double weaponbulk(){
		return 75+(weaponstatus[D4RTS_CHAMBER]>1?ENC_BRONTOSHELLLOADED:0);
	}
	override string,double getpickupsprite(){return "BLSTA0",1.;}
	override void DrawHUDStuff(HDStatusBar sb,HDWeapon hdw,HDPlayerPawn hpl){
		if(sb.hudlevel==1){
			sb.drawimage("MCLLA0",(-48,-10),sb.DI_SCREEN_CENTER_BOTTOM,scale:(0.7,0.7));
			sb.drawnum(hpl.countinv("HDMicroCell"),-45,-8,sb.DI_SCREEN_CENTER_BOTTOM);
		}
		if(hdw.weaponstatus[D4RTS_CHAMBER]>1)sb.drawrect(-21,-13,5,3);
		sb.drawwepnum(
			hpl.countinv("HDMicroCell"),
			(HDCONST_MAXPOCKETSPACE/ENC_BRONTOSHELL)
		);
	}
	override string gethelptext(){
		LocalizeHelp();
		return
		LWPHELP_FIRESHOOT
		..LWPHELP_RELOADRELOAD
		..LWPHELP_UNLOADUNLOAD
		;
	}
	override void DrawSightPicture(HDStatusBar sb, HDWeapon hdw, HDPlayerPawn hpl, bool sightbob, vector2 bob, double fov, bool scopeview, actor hpc, string whichdot)
    {
		vector2 bobb=bob*1.1;
        double degree=6.;
        int cx,cy,cw,ch;
        switch (WeaponStatus[D4RTS_OPTIC])
        {
            case 0:
            {
			    [cx,cy,cw,ch]=Screen.GetClipRect();
                sb.SetClipRect(
                    -16+bob.x,-64+bob.y,32,76,
                    sb.DI_SCREEN_CENTER
                );
		        sb.drawimage(
		        	"TRNFSITE",(0,-12)+bobb,sb.DI_SCREEN_CENTER|sb.DI_ITEM_TOP,
		        	scale:(1.35,1.4),
		        	alpha:0.8
		        );
		        sb.SetClipRect(cx,cy,cw,ch);
		        sb.drawimage(
		        	"TRNBSITE",(0,-5)+bob,sb.DI_SCREEN_CENTER|sb.DI_ITEM_TOP,
		        	scale:(1.45,1.5)
		        ); break;
            }
            case 1:
            {
			    int scaledwidth=56;
			    int scaledyoffset=(scaledwidth>>1)+12;
			    [cx,cy,cw,ch]=screen.GetClipRect();
			    sb.SetClipRect(
			    	-28+bob.x,12+bob.y,scaledwidth,scaledwidth,
			    	sb.DI_SCREEN_CENTER
			    );
			    double dotoff=max(abs(bob.x),abs(bob.y));
			    /*sb.drawimage(
			    	"SRVR_SC0",(0,0)+bob,sb.DI_SCREEN_CENTER|sb.DI_ITEM_CENTER,scale:(1.1,1.1)
			    );*/
			    texman.setcameratotexture(hpc,"HDXCAM_ZM66",degree);
			    let cam=texman.CheckForTexture("HDXCAM_ZM66",TexMan.Type_Any);
			    double camSize=texman.GetSize(cam);
			    sb.DrawCircle(cam,(0,scaledyoffset)+bob,.085,usePixelRatio:true);
			    let reticle = texman.CheckForTexture("trnreti2",TexMan.Type_Any);
			    	if((bob.y/fov)<0.4){
			    		let reticleScale = camSize / texman.GetSize(reticle);
			    		{
			    			sb.DrawCircle(reticle,(0,scaledyoffset)+bobb,.403*reticleScale, uvScale: .62);
			    		}
			    	}
                
			    	screen.SetClipRect(cx,cy,cw,ch);
                
			    sb.drawimage(
			    	"bossscope",(0,scaledyoffset)+bob,sb.DI_SCREEN_CENTER|sb.DI_ITEM_CENTER,scale:(0.9,0.9)
			    ); break;
            }
            case 2:
            {
			    [cx,cy,cw,ch]=Screen.GetClipRect();
                sb.SetClipRect(
                    -16+bob.x,-64+bob.y,32,76,
                    sb.DI_SCREEN_CENTER
                );
                sb.drawimage(
                    "bsfrntsit",bob*1.14,sb.DI_SCREEN_CENTER|sb.DI_ITEM_TOP
                );
                sb.SetClipRect(cx,cy,cw,ch);
        
                sb.drawimage(
                    "bsbaksit",(0,0)+bob,sb.DI_SCREEN_CENTER|sb.DI_ITEM_TOP,
                    alpha:0.9
                );
                
                if(scopeview){
                    int scaledwidth=89;
                    int scaledyoffset=60;
                    double degree=0.1*hdw.weaponstatus[D4RTS_ZOOM];
                    double deg=1/degree;
                    int cx,cy,cw,ch;
                    [cx,cy,cw,ch]=screen.GetClipRect();
                    sb.SetClipRect(-44+bob.x,16+bob.y,scaledwidth,scaledwidth,
                        sb.DI_SCREEN_CENTER
                    );
        
                    sb.fill(color(255,0,0,0),
                        bob.x-44,scaledyoffset+bob.y-44,
                        88,88,sb.DI_SCREEN_CENTER|sb.DI_ITEM_CENTER
                    );
        
                    texman.setcameratotexture(hpc,"HDXCAM_BOSS",degree);
                    let cam     = texman.CheckForTexture("HDXCAM_BOSS",TexMan.Type_Any);
                    let reticle = texman.CheckForTexture("reticle1",TexMan.Type_Any);
        
                    vector2 frontoffs=(0,scaledyoffset)+bob*3;
        
                    double camSize  = texman.GetSize(cam);
                    sb.DrawCircle(cam, frontoffs, 0.125,usePixelRatio:true);
        
                    //[2022-09-17] there's a glitch in GZDoom where if the reticle would be drawn completely off screen,
                    //the cliprect is ignored. The figure is a product of trial and error.
                    if((bob.y/fov)<0.4){
                        let reticleScale = camSize / texman.GetSize(reticle);
                        sb.DrawCircle(reticle, (0,scaledyoffset)+bob, 0.5*reticleScale,uvScale:.5);
                    }
        
                    //let holeScale    = camSize / texman.GetSize(hole);
                    //let hole    = texman.CheckForTexture("scophole",TexMan.Type_Any);
                    //sb.DrawCircle(hole, (0, scaledyoffset) + bob, .5 * holeScale, bob * 5, 1.5);
        
        
                    screen.SetClipRect(cx,cy,cw,ch);
        
                    sb.drawimage(
                        "bossscope",(0,scaledyoffset)+bob,sb.DI_SCREEN_CENTER|sb.DI_ITEM_CENTER,
                        scale:(1.24,1.24)
                    );
                    sb.drawstring(
                        sb.mAmountFont,string.format("%.1f",degree),
                        (6+bob.x,105+bob.y),sb.DI_SCREEN_CENTER|sb.DI_TEXT_ALIGN_RIGHT,
                        Font.CR_BLACK
                    );
                    sb.drawstring(
                        sb.mAmountFont,string.format("%i",hdw.weaponstatus[BOSSS_DROPADJUST]),
                        (6+bob.x,9+bob.y),sb.DI_SCREEN_CENTER|sb.DI_TEXT_ALIGN_RIGHT,
                        Font.CR_BLACK
                    );
                }
                // the scope display is in 10ths of an arcminute.
                // one dot = 6 arcminutes. break;
            }
        }
    }
	override void DropOneAmmo(int amt){
		if(owner){
			amt=clamp(amt,1,10);
			owner.A_DropInventory("HDMicroCell",1);
		}
	}
	states{
	select0:
		BLSG A 0;
		goto select0small;
	deselect0:
		BLSG A 0;
		goto deselect0small;
	ready:
		BLSG A 1 A_WeaponReady(WRF_ALL);
		goto readyend;
	fire:
		BLSG A 1 offset(0,34){
            invoker.charge = 3;
			if(invoker.weaponstatus[D4RTS_CHAMBER]<2){
				setweaponstate("nope");
				return;
			}
			A_GunFlash();
			A_StartSound("weapons/d4rt",CHAN_WEAPON);
		    int minDamage, maxDamage;
		    switch (invoker.charge)
		    {
		    	case 1: minDamage = 100; maxDamage = 150; break;
		    	case 2: minDamage = 300; maxDamage = 550; break;
		    	case 3: minDamage = 800; maxDamage = 1200; break;
		    }
		    string puff = "D4RTImpactT"..invoker.charge;
		    A_RailAttack(random(minDamage, maxDamage), 0, false, "", "", RGF_NORANDOMPUFFZ | RGF_SILENT, 0, puff, 0, 0, HDCONST_ONEMETRE * 300, 0, 10.0, 0, "D4RTRaySegment", player.crouchfactor < 1.0 ? 0.9 : 1.8);
		    A_AlertMonsters();
		    A_ZoomRecoil(1.00 - 0.2 * invoker.charge);
			invoker.weaponstatus[D4RTS_CHAMBER]=1;
			invoker.weaponstatus[D4RTS_HEAT]+=32;
		}
		BLSG B 2;
		BLSG B 0 A_JumpIf(
			hd_instagib
			&&player
			&&player.bot
		,"reload");
		goto nope;
	flash:
		BLSF A 1 bright{
			A_AlertMonsters();
			HDFlashAlpha(0,true);
			A_Light1();
		}
		BLSF B 1{
			A_Light1();
		}
		TNT1 A 1 A_Light0();
		stop;
	reload:
		BLSG A 0{
			invoker.weaponstatus[0]&=~D4RTF_JUSTUNLOAD;
			if(
				invoker.weaponstatus[D4RTS_CHAMBER]>1
				||(
					!hd_instagib
					&&!countinv("HDMicroCell")
				)
			)setweaponstate("nope");
		}goto unloadstart;
	unload:
		BLSG A 0{
			invoker.weaponstatus[0]|=D4RTF_JUSTUNLOAD;
		}goto unloadstart;

	unloadstart:
		BLSG A 1;
		BLSG CCC 2 A_MuzzleClimb(
			-frandom(0.5,0.6),frandom(0.5,0.6),
			-frandom(0.5,0.6),frandom(0.5,0.6),
			wepdot:false
		);
		BLSG C 1 offset(1,34);
		BLSG C 1 offset(2,44) A_SetTics(invoker.weaponstatus[D4RTS_HEAT]>>3);
		BLSG C 1 offset(3,42) A_StartSound("weapons/D4RT_Reload_A",8,CHANF_OVERLAP);
		BLSG D 3 offset(4,34){
			int chm=invoker.weaponstatus[D4RTS_CHAMBER];
			int bheat=invoker.weaponstatus[D4RTS_HEAT];
			invoker.weaponstatus[D4RTS_CHAMBER]=0;
			if(chm<1){
				A_SetTics(3+max(0,bheat-20));
				return;
			}

			A_StartSound("weapons/D4RT_Reload_B",8,CHANF_OVERLAP);
			if(chm>1){
				double aaa=angle;
				bool id=(HDMath.PlayingId());
				if(id)aaa+=5;else aaa-=5;
				let bbr=spawn("HDMicroCell",
					pos+(
						cos(pitch)*(
							cos(aaa)*10,
							sin(aaa)*10
						),
						height*0.8-sin(pitch)*8
					),ALLOW_REPLACE
				);
				bbr.translation=translation;
				if(id)aaa=angle+50;else aaa=angle-50;
				bbr.vel=(vel.xy+(cos(aaa),sin(aaa)),vel.z+1.);
				if(!A_JumpIfInventory("HDMicroCell",0,"null"))GrabThinker.Grab(self,bbr,5);
			}else if(chm==1){
				A_StartSound("weapons/D4RT_Reload_B",8,CHANF_OVERLAP,
					volume:0.04*bheat
				);
				A_SpawnItemEx("MM_MCellCasing",
					cos(pitch)*4,0,height*0.8-sin(pitch)*4,
					vel.x,vel.y,vel.z+min(0.12*bheat,4),
					frandom(-1,1),SXF_ABSOLUTEMOMENTUM|
					SXF_NOCHECKPOSITION|SXF_TRANSFERPITCH|
					SXF_TRANSFERTRANSLATION
				);
			}
		}
		BLSG E 1 offset(0,36);
		BLSG E 1 offset(0,38){
			if(!(invoker.weaponstatus[0]&D4RTF_JUSTUNLOAD))A_StartSound("weapons/pocket",9,CHANF_OVERLAP);
		}
		BLSG E 1 offset(0,42);
		BLSG E 1 offset(0,48);
		BLSG E 1 offset(0,54);
		BLSG E 1 offset(0,62);
		TNT1 A 3;
		TNT1 A 8 A_JumpIf(invoker.weaponstatus[0]&D4RTF_JUSTUNLOAD,1);
		TNT1 A 10{
			if(invoker.weaponstatus[0]&D4RTF_JUSTUNLOAD)return;
			invoker.weaponstatus[D4RTS_CHAMBER]=2;
			A_TakeInventory("HDMicroCell",1,TIF_NOTAKEINFINITE);
			A_StartSound("weapons/D4RT_Reload_B",8,CHANF_OVERLAP);
		}
		BLSG B 1 offset(0,67);
		BLSG B 1 offset(0,60);
		BLSG B 1 offset(0,56);
		BLSG B 1 offset(0,53);
		BLSG B 1 offset(0,52);
	reloadend:
		BLSG B 1 offset(0,48);
		BLSG B 1 offset(0,44);
		BLSG B 1 offset(0,36);
		BLSG B 1 offset(0,33) A_StartSound("weapons/D4RT_Reload_C",8,CHANF_OVERLAP);
		BLSG BA 2 offset(0,34);
		BLSG A 0 A_JumpIf(pressingunload(),"nope");
		goto ready;

	spawn:
		BLST A -1;
		stop;
	}override void LoadoutConfigure(string input)
    {
        switch (GetLoadoutVar(input, "optic", 1))
        {
            case 0:WeaponStatus[D4RTS_OPTIC]=0; break;
            case 1: WeaponStatus[D4RTS_OPTIC]=1; int zoom=getloadoutvar(input,"zoom",3); if(zoom>0)weaponstatus[D4RTS_ZOOM]=clamp(zoom,12,40); break;
            case 2: WeaponStatus[D4RTS_OPTIC]=2; break;
            default: break;
        }

        InitializeWepStats(false);
    }
	override void InitializeWepStats(bool idfa){
		weaponstatus[D4RTS_CHAMBER]=2;
		if(!idfa){
			weaponstatus[0]=0;
			weaponstatus[D4RTS_HEAT]=0;
		}
	}
}

enum d4rtstatus{
	D4RTF_JUSTUNLOAD=1,

	D4RTS_STATUS=0,
	D4RTS_CHAMBER=1,
	D4RTS_HEAT=2,
	D4RTS_OPTIC=3,
    D4RTS_ZOOM=4,
};

//map pickup
class MM_DartSpawner:IdleDummy{
	states{
	spawn:
		TNT1 A 0 nodelay{
			A_SpawnItemEx("HDMicroCell",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION);
			A_SpawnItemEx("HDMicroCell",3,0,0,0,0,0,0,SXF_NOCHECKPOSITION);
			A_SpawnItemEx("HDMicroCell",1,0,0,0,0,0,0,SXF_NOCHECKPOSITION);
			A_SpawnItemEx("HDMicroCell",-3,0,0,0,0,0,0,SXF_NOCHECKPOSITION);
			A_SpawnItemEx("MM_Dart",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION);
		}stop;
	}
}

class D4RTImpact : Actor abstract
{
	protected abstract void OnBlast(bool miss);
	protected void SpawnBlastEffects(int tier, bool miss)
	{
		pcol1 = HDMath.PlayingID() ? 0xAAFF42 : 0x0098ff;
		pcol2 = HDMath.PlayingID() ? 0xDFFF66 : 0x0098ff;
		// Ball.
		for (int i = -180; i < 180; i += 10)
		{
			for (int j = -90 + 10; j < 90 - 9; j += 10)
			{
				A_SpawnParticle(pcol2, SPF_FULLBRIGHT | SPF_RELATIVE, 10 + tier, 24 + 4 * tier, i, 0, 0, 0, 4 * cos(j) * level.pixelstretch, 0, 4 * sin(j), sizestep: 0.2);
			}
		}

		if (miss)
		{
			// Spears.
			for (int i = 0; i < 10 * (tier + 1); ++i)
			{
				pitch = frandom(-85.0, 85.0);
				double smokeVel = frandom(10 + 5 * tier, 20 + 10 * tier);
				A_SpawnItemEx("D4RTImpactSpear", 0, 0, 0, smokeVel * cos(pitch), 0, smokeVel * sin(pitch), random(0, 359), SXF_NOCHECKPOSITION);
			}
		}
	}

	Color pcol1;
	Color pcol2;

	Default
	{
		+FORCEDECAL
		+PUFFGETSOWNER
		+ALWAYSPUFF
		+PUFFONACTORS
		+NOINTERACTION
		+BLOODLESSIMPACT
		+FORCERADIUSDMG
		+NOBLOOD
		+HITTRACER
		Decal "D4RTScorch";
		DamageType "Electrical";
	}

	States
	{
		Spawn:
			TNT1 A 16 NoDelay OnBlast(false);
			Stop;
		Crash:
			TNT1 A 16 OnBlast(true);
			Stop;
	}
}

class D4RTImpactT1 : D4RTImpact
{
	override void OnBlast(bool miss)
	{
		DoorDestroyer.DestroyDoor(self, 4, 2, dedicated: true); 
		A_Explode(random(50, 100), int(HDCONST_ONEMETRE * 0.25), XF_HURTSOURCE, false, damageType: 'Electrical');
		A_StartSound("D4RT/RayHit", 8, attenuation: 0.5);
		//DistantQuaker.Quake(self, 2, 50, HDCONST_ONEMETRE * 30, 10, 256, 512, 128);
		SpawnBlastEffects(0, miss);
	}
}

class D4RTImpactT2 : D4RTImpact
{
	override void OnBlast(bool miss)
	{
		DoorDestroyer.DestroyDoor(self, 16, 8, dedicated: true); 
		A_Explode(random(300, 600), int(HDCONST_ONEMETRE * 0.3), XF_HURTSOURCE, false, damageType: 'Electrical');
		A_StartSound("D4RT/RayHit", 8, attenuation: 0.2, pitch: 0.8);
		//DistantQuaker.Quake(self, 4, 50, HDCONST_ONEMETRE * 70, 10, 256, 512, 128);
		SpawnBlastEffects(1, miss);
	}
}

class D4RTImpactT3 : D4RTImpact
{
	override void OnBlast(bool miss)
	{
		DoorDestroyer.DestroyDoor(self, 28, 12, dedicated: true); 
		A_Explode(random(1000, 1500), int(HDCONST_ONEMETRE * 0.5), XF_HURTSOURCE, false, damageType: 'Electrical');
		A_StartSound("D4RT/RayHit", 8, attenuation: ATTN_NONE, pitch: 0.6);
		//DistantQuaker.Quake(self, 6, 50, HDCONST_ONEMETRE * 200, 10, 256, 512, 128);
		SpawnBlastEffects(2, miss);
	}
}

class D4RTRaySegment : Actor
{
	override void PostBeginPlay()
	{
		Super.PostBeginPlay();
		pcol = HDMath.PlayingId() ? 0xDFFF66 : 0x0098ff;
		for (int i = 0; i < 2; ++i)
		{
			A_SpawnParticle(pcol, SPF_RELATIVE | SPF_FULLBRIGHT, random(100, 200), frandom(1.5, 3.0), 0,random(-10, 10), 0, 0,
				frandom(-0.10, 0.10), frandom(-0.10, 0.10), frandom(-0.10, 0.10),
				frandom(-0.005, 0.005), frandom(-0.005, 0.005), frandom(-0.005, 0.005));
		}
		if (target)
		{
			double dist = Distance3D(target);
			alpha += 0.00075 * dist;
		}
	}

	private double FadeSpeed;
	Color pcol;

	Default
	{
		Renderstyle "Add";
		+NOINTERACTION
		+NOBLOCKMAP
		+BRIGHT
		Alpha 1.0;
	}

	States
	{
		Spawn:
			GNGY A 1 Bright A_FadeOut(0.05);
			Loop;
	}
}

class D4RTImpactSpear : Actor
{
	override void PostBeginPlay()
	{
		ReactionTime = int(ReactionTime * frandom(0.10, 1.0));

		Super.PostBeginPlay();
	}

	Default
	{
		+NOINTERACTION
		Gravity 0.4;
		ReactionTime 70;
	}

	Name smoke;

	States
	{
		Spawn:
			TNT1 A 1
			{
				if (!level.IsPointInLevel(pos) || --ReactionTime == 0)
				{
					Destroy();
					return;
				}

				vel *= 0.97;
				vel.z -= 1.0 * Gravity;

				smoke = HDMath.PlayingID() ? "D4RTSmoke" : "D4RTSmokeFD";
				A_SpawnItemEx(smoke);
			}
			Loop;
	}
}

class D4RTLight:PointLight{
	Color col1;
	Color col2;
	Color col3;
	override void postbeginplay(){
		super.postbeginplay();
		col1 = HDMath.PlayingID()?103:0;
		col2 = HDMath.PlayingID()?242:255;
		col3 = HDMath.PlayingID()?108:152;
		args[0]=col1;
		args[1]=col2;
		args[2]=col3;
		args[3]=84;
		args[4]=0;
	}
	override void tick(){
		if(!target){
			args[3]+=random(-10,1);
			if(args[3]<1)destroy();
		}else{
			if(target.bmissile)args[3]=random(32,40);
			else args[3]=random(48,64);
			setorigin(target.pos,true);
		}
	}
}