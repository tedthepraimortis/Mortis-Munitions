class MM_Cayanesis:HDWeapon{
	default{
		+hdweapon.fitsinbackpack
		obituary "$OB_CAYANESIS";
		weapon.selectionorder 67;
		weapon.slotnumber 4;
		weapon.slotpriority 3;
		weapon.kickback 15;
		weapon.bobrangex 0.11;
		weapon.bobrangey 0.6;
		weapon.bobspeed 1.5;
		scale 0.5;
		inventory.pickupmessage "$PICKUP_CAYANESIS";
		hdweapon.barrelsize 26,0.5,1;
		hdweapon.refid "cyn";
		tag "$TAG_CAYANESIS";
		inventory.icon "CYNPA0";

		hdweapon.ammo1 "MM_CayanesisMag",1;

		hdweapon.loadoutcodes "
			\cufiremode - 0-2, semi/burst/auto
			\cufireswitch - 0-4, default/semi/auto/full/all
			\cudot - 0-5";
	}
    private transient CVar AHelpText;
	override bool AddSpareWeapon(actor newowner){return AddSpareWeaponRegular(newowner);}
	override hdweapon GetSpareWeapon(actor newowner,bool reverse,bool doselect){return GetSpareWeaponRegular(newowner,reverse,doselect);}
	override double gunmass(){
		return 5+((weaponstatus[CYAS_MAG]<0)?-0.5:(weaponstatus[CYAS_MAG]*0.05));
	}
	override double weaponbulk(){
		int mg=weaponstatus[CYAS_MAG];
		if(mg<0)return 90;
		else return (90+ENC_9MAG30_LOADED)+mg*ENC_9_LOADED;
	}
	override void failedpickupunload(){
		failedpickupunloadmag(CYAS_MAG,"MM_CayanesisMag");
	}
	override void DropOneAmmo(int amt){
		if(owner){
			amt=clamp(amt,1,10);
			if(owner.countinv("HD6mmFlechetteAmmo"))owner.A_DropInventory("HD6mmFlechetteAmmo",amt*50);
			else owner.A_DropInventory("MM_CayanesisMag",amt);
		}
	}
	override void postbeginplay(){
		super.postbeginplay();
		if(weaponstatus[CYAS_AUTO]>0){
		switch(weaponstatus[CYAS_SWITCHTYPE]){
		case 1:
			weaponstatus[CYAS_AUTO]=0;
			break;
		case 2:
			weaponstatus[CYAS_AUTO]=1;
			break;
		case 3:
			weaponstatus[CYAS_AUTO]=2;
			break;
		default:
			break;
		}}
	}
	override void ForceBasicAmmo(){
		owner.A_TakeInventory("HD6mmFlechetteAmmo");
		ForceOneBasicAmmo("MM_CayanesisMag");
	}
	override void Consolidate(){
		ConsolidateRegularMagReload("MM_CayanesisMag",CYAS_MAG);
	}
	override string,double getpickupsprite(bool usespare){
		int wep0=GetSpareWeaponValue(0,usespare);
		string letter1; string letter2;
		if(GetSpareWeaponValue(CYAS_SWITCHTYPE,usespare)!=1){
			letter1="D"; letter2="C"; 
		}else{
			letter1="B"; letter2="A"; 
		}
		return "CYNP"..((GetSpareWeaponValue(CYAS_MAG,usespare)<0)?letter1:letter2).."0",1.;
	}
	override void DrawHUDStuff(HDStatusBar sb,HDWeapon hdw,HDPlayerPawn hpl){
		if(sb.hudlevel==1){
			int nextmagloaded=sb.GetNextLoadMag(hdmagammo(hpl.findinventory("MM_CayanesisMag")));
			if(nextmagloaded>=50){
				sb.drawimage("CLP3A0",(-46,-3),sb.DI_SCREEN_CENTER_BOTTOM,scale:(3,3));
			}else if(nextmagloaded<1){
				sb.drawimage("CLP3B0",(-46,-3),sb.DI_SCREEN_CENTER_BOTTOM,alpha:nextmagloaded?0.6:1.,scale:(3,3));
			}else sb.drawbar(
				"CLP3NORM","CLP3GREY",
				nextmagloaded,30,
				(-46,-3),-1,
				sb.SHADER_VERT,sb.DI_SCREEN_CENTER_BOTTOM
			);

			sb.drawimage("XLS1A0",(-56,-10),basestatusbar.DI_SCREEN_CENTER_BOTTOM);
			sb.drawnum(hpl.countinv("HDExplosiveShellAmmo"),-56,-8,
				basestatusbar.DI_SCREEN_CENTER_BOTTOM
			);

			sb.drawnum(hpl.countinv("MM_CayanesisMag"),-43,-8,sb.DI_SCREEN_CENTER_BOTTOM);
			
			if(hdw.weaponstatus[CYAS_SHOTGUNCHAMBER]){
				sb.drawrect(-21,-16,3,2);
				sb.drawrect(-17,-16,1,2);
			}
			for(int i=hdw.weaponstatus[CYAS_TUBE];i>0;i--){
				sb.drawrect(-15-i*6,-5,3,2);
				sb.drawrect(-11-i*6,-5,1,2);
			}
		}
		if(weaponstatus[CYAS_SWITCHTYPE]!=1)sb.drawwepcounter(hdw.weaponstatus[CYAS_AUTO],
			-22,-10,"RBRSA3A7","STBURAUT","STFULAUT"
		);
		sb.drawwepnum(hdw.weaponstatus[CYAS_MAG],50);
		if(hdw.weaponstatus[CYAS_CHAMBER]==2)sb.drawrect(-19,-11,3,1);
	}
	override string gethelptext(){
		LocalizeHelp();
        if(!AHelpText) AHelpText = CVar.GetCVar('mm_advanced_helptext', owner.player);
		return
		LWPHELP_FIRESHOOT
		..LWPHELP_RELOAD..StringTable.Localize("$SMGWH_FIRE")
		..LWPHELP_USE.."+"..LWPHELP_RELOAD..StringTable.Localize("$SMGWH_UPRELOAD")
		..LWPHELP_FIREMODE..StringTable.Localize("$SMGWH_FMODE")
		..LWPHELP_ALTFIRE..Stringtable.Localize("$CYA_ALTFIRE")
		..LWPHELP_ALTRELOAD..Stringtable.Localize("$CYA_ALTRELOAD")
		..LWPHELP_ALTFIRE.."+"..LWPHELP_RELOAD.."/"..LWPHELP_ALTRELOAD..Stringtable.Localize("$CYA_RELOADCHAMBER")
		..LWPHELP_MAGMANAGER
		..LWPHELP_UNLOADUNLOAD
        ..(AHelpText.GetBool() ? Stringtable.Localize("$WEPHELP_INFO") : "")
        ..(AHelpText.GetBool() ? Stringtable.Localize("$CYA_HELPTEXT_1") : "")
        ..(AHelpText.GetBool() ? Stringtable.Localize("$CYA_HELPTEXT_2") : "")
        ..(AHelpText.GetBool() ? Stringtable.Localize("$CYA_HELPTEXT_3") : "");
	}
	override void DrawSightPicture(
		HDStatusBar sb,HDWeapon hdw,HDPlayerPawn hpl,
		bool sightbob,vector2 bob,double fov,bool scopeview,actor hpc
	){
		vector2 bobb=bob*1.18;
		double dotoff=max(abs(bob.x),abs(bob.y));
		if(dotoff<30){
			string whichdot=sb.ChooseReflexReticle(hdw.weaponstatus[CYAS_DOT]);
			sb.drawimage(
				whichdot,(0,0)+bobb,sb.DI_SCREEN_CENTER|sb.DI_ITEM_CENTER,
				alpha:0.8-dotoff*0.01,scale:(1.6,1.6),
				col:0xFF000000|sb.crosshaircolor.GetInt()
			);
		}
		sb.drawimage(
			"smgrearsight",(0,0)+bob,sb.DI_SCREEN_CENTER|sb.DI_ITEM_CENTER
		);
	}
	override void SetReflexReticle(int which){weaponstatus[CYAS_DOT]=which;}
	action void A_SetAltHold(bool which){
		if(which)invoker.weaponstatus[0]|=CYAS_ALTHOLDING;
		else invoker.weaponstatus[0]&=~CYAS_ALTHOLDING;
	}
	states{
	select0:
		SMGG A 0 A_CheckDefaultReflexReticle(CYAS_DOT);
		SMGG A 0;
		goto select0small;
	deselect0:
		SMGG A 0;
		goto deselect0small;
		SMGG AB 0;
		SMSG AB 0;

	ready:
		SMGG A 0;
		#### A 1{
			A_SetCrosshair(21);
			invoker.weaponstatus[CYAS_RATCHET]=0;
			A_WeaponReady(WRF_ALL);
			A_SetAltHold(false);
		}
		goto readyend;
	user3:
		---- A 0 A_MagManager("MM_CayanesisMag");
		goto ready;

	hold:
		#### A 0{
			if(
				invoker.weaponstatus[CYAS_CHAMBER]==2  //live round chambered
				&&(
					invoker.weaponstatus[CYAS_AUTO]==2  //full auto
					||(
						invoker.weaponstatus[CYAS_AUTO]==1  //burst
						&&invoker.weaponstatus[CYAS_RATCHET]<=2
					)
				)
			)setweaponstate("fire2");
		}goto nope;
	user2:
	firemode:
		---- A 1{
			int canaut=invoker.weaponstatus[CYAS_SWITCHTYPE];
			if(canaut==1){
				invoker.weaponstatus[CYAS_AUTO]=0;
				return;
			}
			int maxmode=(canaut>0)?(canaut-1):2;
			int aut=invoker.weaponstatus[CYAS_AUTO];
			if(aut>=maxmode)invoker.weaponstatus[CYAS_AUTO]=0;
			else if(aut<0)invoker.weaponstatus[CYAS_AUTO]=0;
			else if(canaut>0)invoker.weaponstatus[CYAS_AUTO]=maxmode;
			else invoker.weaponstatus[CYAS_AUTO]++;
		}goto nope;

	unloadchamber:
		#### B 1 A_JumpIf(invoker.weaponstatus[CYAS_CHAMBER]<1,"nope");
		#### B 2 offset(3,32){
			class<actor>which=invoker.weaponstatus[CYAS_CHAMBER]>1?"HD6mmFlechetteAmmo":"HDSpent6mmFlechette";
			invoker.weaponstatus[CYAS_CHAMBER]=0;
			
			A_EjectCasing(which,frandom(-1,2),(frandom(0.2,0.3),-frandom(2,2.5),frandom(0,0.2)),(0,0,-2));
			A_StartSound("weapons/smgchamber2",8,CHANF_OVERLAP);
		}
		#### B 3 offset(5,35);
		#### A 1 offset(3,32);
		#### A 1 offset(2,31);
		goto readyend;
	loadchamber:
		---- A 0 A_JumpIf(invoker.weaponstatus[CYAS_CHAMBER]>0,"nope");
		---- A 0 A_JumpIf(!countinv("HD6mmFlechetteAmmo"),"nope");
		---- A 1 offset(0,34) A_StartSound("weapons/pocket",9);
		---- A 1 offset(2,36);
		---- A 1 offset(2,44);
		#### B 1 offset(5,58);
		#### B 2 offset(7,70);
		#### B 6 offset(8,80);
		#### A 10 offset(8,87){
			if(countinv("HD6mmFlechetteAmmo")){
				A_TakeInventory("HD6mmFlechetteAmmo",1,TIF_NOTAKEINFINITE);
				invoker.weaponstatus[CYAS_CHAMBER]=2;
				A_StartSound("weapons/smgchamber",8);
			}else A_SetTics(4);
		}
		#### A 3 offset(9,76);
		---- A 2 offset(5,70);
		---- A 1 offset(5,64);
		---- A 1 offset(5,52);
		---- A 1 offset(5,42);
		---- A 1 offset(2,36);
		---- A 2 offset(0,34);
		goto nope;
	user4:
	unload:
		#### A 0{
			invoker.weaponstatus[0]|=CYAF_JUSTUNLOAD;
			if(
				invoker.weaponstatus[CYAS_MAG]>=0
			)setweaponstate("unmag");
			else if(invoker.weaponstatus[CYAS_CHAMBER]>0)setweaponstate("unloadchamber");
		}goto nope;
	reload:
		#### A 0{
			invoker.weaponstatus[0]&=~CYAF_JUSTUNLOAD;
			bool nomags=HDMagAmmo.NothingLoaded(self,"MM_CayanesisMag");
			if(invoker.weaponstatus[CYAS_MAG]>=50)setweaponstate("nope");
			else if(
				invoker.weaponstatus[CYAS_MAG]<1
				&&(
					pressinguse()
					||nomags
				)
			){
				if(
					countinv("HD6mmFlechetteAmmo")
				)setweaponstate("loadchamber");
				else setweaponstate("nope");
			}else if(nomags)setweaponstate("nope");
		}goto unmag;
	unmag:
		#### A 1 offset(0,34) A_SetCrosshair(21);
		#### A 1 offset(5,38);
		#### A 1 offset(10,42);
		#### B 2 offset(20,46) A_StartSound("weapons/smgmagclick",8);
		#### B 4 offset(30,52){
			A_MuzzleClimb(0.3,0.4,wepdot:false);
			A_StartSound("weapons/smgmagmove",8,CHANF_OVERLAP);
		}
		#### B 0{
			int magamt=invoker.weaponstatus[CYAS_MAG];
			if(magamt<0){
				setweaponstate("magout");
				return;
			}
			invoker.weaponstatus[CYAS_MAG]=-1;
			if(
				(!PressingUnload()&&!PressingReload())
				||A_JumpIfInventory("MM_CayanesisMag",0,"null")
			){
				HDMagAmmo.SpawnMag(self,"MM_CayanesisMag",magamt);
				setweaponstate("magout");
			}else{
				HDMagAmmo.GiveMag(self,"MM_CayanesisMag",magamt);
				A_StartSound("weapons/pocket",9);
				setweaponstate("pocketmag");
			}
		}
	pocketmag:
		#### BB 7 offset(34,54) A_MuzzleClimb(frandom(0.2,-0.8),frandom(-0.2,0.4),wepdot:false);
	magout:
		#### B 0{
			if(invoker.weaponstatus[0]&CYAF_JUSTUNLOAD)setweaponstate("reloadend");
			else setweaponstate("loadmag");
		}

	loadmag:
		#### B 0 A_StartSound("weapons/pocket",9);
		#### B 6 offset(34,54) A_MuzzleClimb(frandom(0.2,-0.8),frandom(-0.2,0.4),wepdot:false);
		#### B 7 offset(34,52) A_MuzzleClimb(frandom(0.2,-0.8),frandom(-0.2,0.4),wepdot:false);
		#### B 10 offset(32,50);
		#### B 3 offset(32,49){
			let mmm=hdmagammo(findinventory("MM_CayanesisMag"));
			if(mmm){
				invoker.weaponstatus[CYAS_MAG]=mmm.TakeMag(true);
				A_StartSound("weapons/smgmagclick",8,CHANF_OVERLAP);
			}
			if(
				invoker.weaponstatus[CYAS_MAG]<1
				||invoker.weaponstatus[CYAS_CHAMBER]>0
			)setweaponstate("reloadend");
		}
		goto reloadend;

	reloadend:
		#### B 3 offset(30,52);
		#### B 2 offset(20,46);
		#### A 1 offset(10,42);
		#### A 1 offset(5,38);
		#### A 1 offset(0,34);
		goto chamber_manual;

	chamber_manual:
		#### A 0 A_JumpIf(
			invoker.weaponstatus[CYAS_MAG]<1
			||invoker.weaponstatus[CYAS_CHAMBER]==2
		,"nope");
		#### B 2 offset(3,32){
			A_WeaponBusy();
			invoker.weaponstatus[CYAS_MAG]--;
			invoker.weaponstatus[CYAS_CHAMBER]=2;
		}
		#### B 3 offset(5,35) A_StartSound("weapons/smgchamber",8,CHANF_OVERLAP);
		#### A 1 offset(3,32);
		#### A 1 offset(2,31);
		goto nope;

	fire:
		#### A 0;
	fire2:
		#### B 1{
			if(invoker.weaponstatus[CYAS_CHAMBER]==2)A_GunFlash();
			else setweaponstate("chamber_manual");
		}
		#### A 1;
		#### A 0{
			if(invoker.weaponstatus[CYAS_CHAMBER]==1){
				A_EjectCasing("HDSpent6mmFlechette",
					frandom(-1,2),
					(frandom(0.2,0.3),-frandom(7,7.5),frandom(0,0.2)),
					(0,0,-2)
				);
				invoker.weaponstatus[CYAS_CHAMBER]=0;
			}
			if(invoker.weaponstatus[CYAS_MAG]>0){
				invoker.weaponstatus[CYAS_MAG]--;
				invoker.weaponstatus[CYAS_CHAMBER]=2;
			}
			if(invoker.weaponstatus[CYAS_AUTO]==2)A_SetTics(1);

			//don't allow firing if supposed to be lowered
			A_WeaponReady(WRF_NOFIRE);
		}
		#### A 0 A_ReFire();
		goto ready;
	flash:
		#### B 0{
			let bbb=HDBulletActor.FireBullet(self,"HDB_MM6mmFlechette",speedfactor:0.97);
			if(
				frandom(16,ceilingz-floorz)<bbb.speed*0.1
			)A_AlertMonsters(200);

			A_ZoomRecoil(0.995);
			A_StartSound("weapons/smg",CHAN_WEAPON,volume:0.7);
			invoker.weaponstatus[CYAS_RATCHET]++;
			invoker.weaponstatus[CYAS_CHAMBER]=1;
		}
		SMGF A 1 bright{
			HDFlashAlpha(-200);
			A_Light1();
		}
		TNT1 A 0 A_MuzzleClimb(-frandom(0.1,0.1),-frandom(0,0.1),-0.2,-frandom(0.3,0.4),-frandom(0.4,1.4),-frandom(1.3,2.6));
		goto lightdone;

	shotflash:
		TNT1 A 0 A_JumpIf(invoker.weaponstatus[CYAS_SHOTGUNCHAMBER],1);
		stop;
		SMGF A 2 bright{
			let p = HDBulletActor.FireBullet(self,"HDB_12GuageSlugMissile",spread:1.5,speedfactor:1.02857,amount:1);
			distantnoise.make(p,"weapons/shotgunfar");
			invoker.A_StartSound("weapons/hunter",CHAN_WEAPON);
			invoker.weaponstatus[CYAS_SHOTGUNCHAMBER]=0;
			invoker.weaponstatus[CYAS_SHOTGUNFIRED]=1;
			A_ZoomRecoil(0.95);
			HDFlashAlpha(-200);
			A_Light1();
		}
		TNT1 A 2 A_MuzzleClimb(0,0,0,0,-1.2,-3.,-1.,-2.8);
		goto lightdone;
	altfire:
		#### A 0{
			if(invoker.weaponstatus[CYAS_SHOTGUNCHAMBER]<=0){
				setweaponstate("pump");
			}
			else if(invoker.WeaponStatus[CYAS_SHOTGUNCHAMBER]==0 && invoker.WeaponStatus[CYAS_TUBE]==0){
				setweaponstate("pump");
			}
		}
		#### A 3 A_Gunflash("shotflash");
		#### A 2;
		goto nope;
	pump:
		#### A 0 A_JumpIf(invoker.weaponstatus[0]&CYAS_ALTHOLDING,"nope");
		#### A 0 A_SetAltHold(true);
		#### A 0 A_ClearOverlays(1025);
		#### A 1 A_StartSound("weapons/huntrackbak",CHAN_WEAPON,CHANF_OVERLAP);
		#### AA 1 A_MuzzleClimb(0,frandom(0.6,1.));
		#### A 1 A_JumpIf(pressingaltfire(),"longstroke");
		goto nope;
	longstroke:
		#### A 2 A_MuzzleClimb(frandom(0.1,0.2));
		#### A 0{
			if(invoker.weaponstatus[CYAS_SHOTGUNFIRED]==1){
				A_OverlayFlags(PSP_FLASH, PSPF_ADDWEAPON, true);
			}
				//A_Chamber();
			A_MuzzleClimb(-frandom(0.1,0.2));
		}
	racked:
		#### A 1 A_WeaponReady(WRF_NOFIRE);
		#### A 1 A_JumpIf((pressingreload() || pressingaltreload()) && countinv("HDExplosiveShellAmmo")>0,"reloadshotgunchamber");
		#### A 0 A_JumpIf(!pressingaltfire(),"unrack");
		loop;
	reloadshotgunchamber:
		#### A 1 offset(2,36) A_ClearRefire();
		#### A 1 offset(3,38);
		#### A 1 offset(5,42);
		#### A 1 offset(8,48) A_StartSound("weapons/pocket",9);
		#### A 1 offset(9,52) A_MuzzleClimb(frandom(-0.2,0.2),0.2,frandom(-0.2,0.2),0.2,frandom(-0.2,0.2),0.2);
		#### A 2 offset(8,60);
		#### A 2 offset(7,72);
		#### A 4{
			A_StartSound("weapons/huntreloadchamber",8,volume:0.7);
			int chm=invoker.weaponstatus[CYAS_SHOTGUNCHAMBER];
			A_TakeInventory("HDExplosiveShellAmmo",1,TIF_NOTAKEINFINITE);
			invoker.weaponstatus[CYAS_SHOTGUNCHAMBER]=1;
		}
		#### A 2 offset(7,72);
		#### A 2 offset(8,60);
		#### A 1 offset(6,52);
		#### A 1 offset(5,42);
		#### A 1 offset(4,38);
		#### A 1 offset(3,35);
		goto racked;
	unrack:
		#### A 0 A_StartSound("weapons/huntrackfwd",CHAN_WEAPON,CHANF_OVERLAP);
		#### A 1 A_JumpIf(!pressingfire(),1);
		#### AA 2{
			if(pressingfire())A_SetTics(1);
			invoker.weaponstatus[CYAS_SHOTGUNFIRED]=0;
			A_MuzzleClimb(0,-frandom(0.6,1.));
		}
		#### A 0 {
			if(invoker.weaponstatus[CYAS_SHOTGUNCHAMBER]==0 && invoker.WeaponStatus[CYAS_TUBE]>=1){
				invoker.weaponstatus[CYAS_SHOTGUNCHAMBER]=1;
				invoker.weaponstatus[CYAS_TUBE]--;
				A_StartSound("weapons/huntopen",CHAN_WEAPON,CHANF_OVERLAP);
			}
		}
		#### A 0 A_ClearRefire();
		goto ready;
	
	altreload:
		#### A 1 A_JumpIf(invoker.weaponstatus[CYAS_TUBE]>=4 || !countinv("HDExplosiveShellAmmo"),"nope");
		#### AA 3 A_MuzzleClimb(frandom(.6,.7),-frandom(.6,.7));
	loadshell:
		#### A 1 offset(0,36);
		#### A 2 offset(0,34){
			A_StartSound("weapons/huntreload",8,CHANF_OVERLAP);
			A_TakeInventory("HDExplosiveShellAmmo",1,TIF_NOTAKEINFINITE);
			invoker.weaponstatus[CYAS_TUBE]++;
		}
		#### ACCCCC 1 offset(0,33){
			if(invoker.weaponstatus[CYAS_TUBE]>=4 || !countinv("HDExplosiveShellAmmo"))setweaponstate("reloadend");
			else if(
				!pressingaltreload()
				&&!pressingreload()
			)setweaponstate("reloadend");
		}
		goto altreload;
	reloadend:
		#### A 3 offset(0,34) A_StartSound("weapons/huntopen",8, CHANF_OVERLAP);
		#### A 1 offset(0,36);
		#### A 1 offset(0,34);
		#### AAA 2;
		#### A 0 A_JumpIf(invoker.weaponstatus[0]&CYAS_ALTHOLDING,"nope");
		goto ready;

	spawn:
		TNT1 A 1;
		CYNP AC -1{
			bool typecheck;
			if(invoker.weaponstatus[CYAS_SWITCHTYPE]!=1){
				frame=2;
				typecheck=true;
			}
			if(invoker.weaponstatus[CYAS_MAG]<0){
				if(typecheck==true){
					frame=3;
				}else{
					frame=1;
				}
			}
		}
		CYNP # -1;
		stop;
	}
	override void initializewepstats(bool idfa){
		weaponstatus[CYAS_MAG]=50;
		weaponstatus[CYAS_CHAMBER]=2;
		weaponstatus[CYAS_SHOTGUNCHAMBER]=1;
		weaponstatus[CYAS_SHOTGUNFIRED]=0;
		weaponstatus[CYAS_TUBE]=4;
	}
	override void loadoutconfigure(string input){
		int firemode=getloadoutvar(input,"firemode",1);
		if(firemode>=0)weaponstatus[CYAS_AUTO]=clamp(firemode,0,2);

		int xhdot=getloadoutvar(input,"dot",3);
		if(xhdot>=0)weaponstatus[CYAS_DOT]=xhdot;

		int fireswitch=getloadoutvar(input,"fireswitch",1);
		if(fireswitch>3)weaponstatus[CYAS_SWITCHTYPE]=0;
		else if(fireswitch>0)weaponstatus[CYAS_SWITCHTYPE]=clamp(fireswitch,0,3);

		weaponstatus[CYAS_SHOTGUNCHAMBER]=1;
		weaponstatus[CYAS_SHOTGUNFIRED]=0;
		weaponstatus[CYAS_TUBE]=4;
		hdammotype2="HDExplosiveShellAmmo";
	}
}
enum cayanesisstatus{
	CYAF_JUSTUNLOAD=1,

	CYAN_SEMIONLY=1,
	CYAN_BURSTONLY=2,
	CYAN_FULLONLY=3,

	CYAS_MAG=1,
	CYAS_CHAMBER=2, //0 empty, 1 spent, 2 loaded
	CYAS_AUTO=3, //0 semi, 1 burst, 2 auto
	CYAS_RATCHET=4,
	CYAS_SWITCHTYPE=5,
	CYAS_DOT=6,
    CYAS_TUBE=7,
    CYAS_SHOTGUNCHAMBER=8,
    CYAS_SHOTGUNFIRED=9,
    CYAS_ALTHOLDING=10,
	CYAS_FLAGS=11,
};

class MM_CayanesisRandom:IdleDummy{
	states{
	spawn:
		TNT1 A 0 nodelay{
			let lll=MM_Cayanesis(spawn("MM_Cayanesis",pos,ALLOW_REPLACE));
			if(!lll)return;
			lll.special=special;
			lll.vel=vel;
			for(int i=0;i<5;i++)lll.args[i]=args[i];
			if(!random(0,2))lll.weaponstatus[CYAS_SWITCHTYPE]=random(0,3);
		}stop;
	}
}

class MM_CayanesisMag:HDMagAmmo{
	default{
		hdmagammo.maxperunit 50;
		hdmagammo.roundtype "HD6mmFlechetteAmmo";
		hdmagammo.roundbulk ENC_6MMFLECHETTE_LOADED;
		hdmagammo.magbulk ENC_9MAG_EMPTY;
		tag "$TAG_CAYANESISMAG";
		inventory.pickupmessage "$PICKUP_CAYANESISMAG";
		hdpickup.refid "650";
	}
	override string,string,name,double getmagsprite(int thismagamt){
		string magsprite=(thismagamt>0)?"CLP2NORM":"CLP2EMPTY";
		return magsprite,"ACRPI3I7","HD6mmFlechetteAmmo",0.5;
	}
	states{
	spawn:
		CLP2 A -1;
		stop;
	spawnempty:
		CLP2 B -1 A_SpawnEmpty();
		stop;
	}
}