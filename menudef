AddOptionMenu "OptionsMenu" {
	Submenu "$MORTISMUNITIONS_MENU", "MortisMunitionsMenu"
}

AddOptionMenu "HDAddonMenu" {
	Submenu "$MORTISMUNITIONS_MENU", "MortisMunitionsMenu"
}

OptionMenu "MortisMunitionsMenu"
{
    class HD_ToolTipOptionMenu
    Title "$MORTISMUNITIONS_MENU"
    
    StaticText ""
    StaticText "$MERCH_TAG_TARONGA"
    Slider "$MENU_WEPSPAWNRATE", "taronga_chaingun_spawn_weight", 0.0, 100, .01, 2
    Slider "$MENU_WEPPRICE", "hdm_taronga_price", 0.0, 10000, 10, 2
    Option "$MENU_ENABLED", "mm_enable_taronga", "OnOff"
    StaticText ""
    StaticText "$MERCH_TAG_SHOTPISTOL"
    Slider "$MENU_WEPSPAWNRATE", "fduster_clipmag_spawn_weight", 0.0, 100, .01, 2
    Slider "$MENU_MAGSPAWNRATE", "fdusterclip_shellbox_spawn_weight", 0.0, 100, .01, 2
    Slider "$MENU_WEPPRICE", "hdm_shotpistol_price", 0.0, 10000, 10, 2
    Slider "$MENU_MAGPRICE", "hdm_shotpistolclip_price", 0.0, 10000, 10, 2
    Option "$MENU_ENABLED", "mm_enable_shotpistol", "OnOff"
    StaticText ""
    StaticText "$MERCH_TAG_JUNCO"
    Slider "$MENU_WEPSPAWNRATE", "junco_clipmag_spawn_weight", 0.0, 100, .01, 2
    Slider "$MENU_WEPSPAWNRATE", "juncomag_clipmag_spawn_weight", 0.0, 100, .01, 2
    Slider "$MENU_WEPPRICE", "hdm_junco_price", 0.0, 10000, 10, 2
    Slider "$MENU_MAGPRICE", "hdm_juncomag_price", 0.0, 10000, 10, 2
    Option "$MENU_ENABLED", "mm_enable_junco", "OnOff"
    StaticText ""
    StaticText "$MERCH_TAG_CURRAWONG"
    Slider "$MENU_WEPSPAWNRATE", "currawong_clipbox_spawn_weight", 0.0, 100, .01, 2
    Slider "$MENU_MAGSPAWNRATE", "currawongmag_clipbox_spawn_weight", 0.0, 100, .01, 2
    Slider "$MENU_WEPPRICE", "hdm_currawong_price", 0.0, 10000, 10, 2
    Slider "$MENU_MAGPRICE", "hdm_currawongmag_price", 0.0, 10000, 10, 2
    Option "$MENU_ENABLED", "mm_enable_currawong", "OnOff"
    StaticText ""
    StaticText ""

    Option "$MENU_ADVANCEDHELPTEXT", "mm_advanced_helptext", "OnOff"
    Option "$MENU_PERSIST", "mm_weapon_persistency", "OnOff"
}
